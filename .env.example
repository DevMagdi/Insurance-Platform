# Run `make init` to generate .env with unique local-only credentials.
POSTGRES_DB=insurance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-generated-secret
APP_DB_PASSWORD=replace-with-generated-secret
APP_WORKER_DB_PASSWORD=replace-with-generated-secret
# Private binaries (attachments, export artifacts, call recordings) are stored
# encrypted inside PostgreSQL with APP_ENCRYPTION_KEY; no object storage is used.
# Mailpit and the SMS-to-mailbox sink are for local development only.
ENVIRONMENT=development
PUBLIC_APP_URL=http://localhost:8080
# The SMS-to-mailbox sink needs a reachable SMTP server; Docker Compose
# overrides this with Mailpit, the Docker-free stack with its own sink.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@insurance.local
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_START_TLS=false
SMTP_USE_TLS=false
# Real staff invitations prefer an enabled workplace email connection in
# Settings > Integrations (SMTP/Gmail/Outlook/SendGrid/SES), NOT sandbox_recipient.
# Production SMTP fallback: real host/from, port 587 + START_TLS=true, or
# port 465 + USE_TLS=true + START_TLS=false. Never use Mailpit/Mailtrap in production.
DEV_SMS_MAILBOX=true
COOKIE_SECURE=true
APP_ENCRYPTION_KEY=replace-with-base64-32-byte-key
APP_BLIND_INDEX_KEY=replace-with-base64-32-byte-key
# HMAC root retained for OTP/lockout/rate-limit digests (not JWT signatures).
JWT_SIGNING_KEY=replace-with-generated-secret
JWT_KEY_ID=active
# Ed25519 JWT keys are URL-safe base64-encoded PEM. `make init` generates them.
JWT_PRIVATE_KEY_B64=replace-with-generated-secret
JWT_PUBLIC_KEY_B64=replace-with-generated-secret
# During rotation, keep old public keys as comma-separated kid:base64url-PEM pairs.
JWT_PREVIOUS_PUBLIC_KEYS=
# Required in production; use a random value of at least 32 characters.
METRICS_TOKEN=replace-with-generated-secret
# Required to create demo logins: set locally (do not commit); seed is opt-in.
DEMO_STAFF_PASSWORD=
# `make bootstrap-admin` prompts for the first administrator. These overrides
# are for automation only; export them for one command instead of storing a
# real password here.
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
