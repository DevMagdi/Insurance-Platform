# Built artifact image: static SPA served by Nginx, which also reverse-proxies the
# API on the SAME origin so the browser never needs CORS and cookies stay first-party.
FROM node:22-alpine AS build
WORKDIR /srv
COPY frontend/package*.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine
# The proxy target is a compose service name; TLS terminates in front of this image.
COPY infra/nginx/prod.conf /etc/nginx/conf.d/default.conf
COPY --from=build /srv/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=3s --retries=5 \
    CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
